# Copy to .env (locally) or paste into Environment in Dokploy.
# Everything here is optional: with nothing set the app still starts, formats
# documents, and falls back to the regex heuristic for rule extraction.

# --- Google sign-in ---------------------------------------------------------
# Formatting works without this. Signing in is needed only so that someone can
# SAVE rules to the library — a rule set has to belong to someone.
#
# Setup: Google Cloud Console -> APIs & Services -> Credentials ->
# Create Credentials -> OAuth client ID -> Web application.
# Under "Authorized redirect URIs" enter exactly the OIDC_REDIRECT_URI below.
# Full walkthrough: docs/google-oauth.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The app's absolute address plus /oauth2callback.
# Local:      http://localhost:8501/oauth2callback
# Production: https://formatter.your-domain.com/oauth2callback
OIDC_REDIRECT_URI=

# Signs the session cookie. Generate with: openssl rand -hex 32
# Changing it signs every user out, so keep it fixed across deploys.
OIDC_COOKIE_SECRET=

# Who may edit and delete OTHER people's rules. Comma-separated addresses.
ADMIN_EMAILS=you@example.com

# --- Optional shared password -----------------------------------------------
# A separate question from signing in: this is "who may reach the app at all".
# Empty = the app is publicly reachable (formatting is open in any case).
APP_PASSWORD=

# --- LLM for rule extraction (optional) -------------------------------------
# The app deploys and runs without this — extraction falls back to a regex
# heuristic. Works with any OpenAI-compatible chat-completions endpoint.
#
# An LLM service on the same Dokploy network: http://<service-name>:8000
# Empty = no LLM.
MATE_BASE_URL=
MATE_PAT=
MATE_AGENT_NAME=doc_rules_extractor
MATE_TIMEOUT=600

# --- Data -------------------------------------------------------------------
# In the container this is the mounted volume. Leave empty locally.
RULES_LIBRARY_DIR=

# Copy to .streamlit/secrets.toml to test Google sign-in locally.
# Do NOT commit the filled-in file — .gitignore already excludes it.
#
# In a container you never write this by hand: docker-entrypoint.sh generates it
# from GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / OIDC_REDIRECT_URI /
# OIDC_COOKIE_SECRET.
#
# Without this file the app runs in local mode: no sign-in, everything permitted.
#
# Full walkthrough: docs/google-oauth.md

[auth]
# Must match "Authorized redirect URIs" in the Google Cloud Console exactly.
redirect_uri = "http://localhost:8501/oauth2callback"
# openssl rand -hex 32
cookie_secret = "replace-me-with-a-random-key"

[auth.google]
client_id = "...apps.googleusercontent.com"
client_secret = "..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
